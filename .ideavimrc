" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc


"" -- Suggested options --
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
set scrolloff=8

" Do incremental searching.
set incsearch
set hls

set clipboard+=unnamed

" Don't use Ex mode, use Q for formatting.
map Q gq

" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins

" Highlight copied text
Plug 'machakann/vim-highlightedyank'
" Commentary plugin
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-surround'
Plug 'preservim/nerdtree'

let mapleader=" "

"" -- Map IDE actions to IdeaVim -- https://jb.gg/abva4t
"" Map \r to the Reformat Code action
"map \r <Action>(ReformatCode)

"
" NOTE: search actions with 
"       :actionlist [pattern]

"" Map <leader>d to start debug
map <leader>d <Action>(Debug)
map <leader>w :w<CR>
map <leader>e :NERDTreeToggle<CR>
map <leader>lf <Action>(ReformatCode)
map <leader>F <Action>(FindInPath)
map <leader>f <Action>(GotoFile)
map <leader>b <Action>(ToggleLineBreakpoint)
map <leader>m <Action>(FileMember)
""map <leader>m <Action>(GotoSymbol)
map <leader>4 <Action>(ViewBreakpoints)
map <leader>r <Action>(RecentFiles)
map <leader>z <Action>(EditorToggleUseSoftWraps)
map gr <Action>(FindUsages)

map <leader><F3> <Action>(ActivateLogcatToolWindow) <Action>(ActivateDebugToolWindow)

map gx <Action>(OpenInBrowser)
map L <Action>(NextTab)
map H <Action>(PreviousTab)

map <leader>c :q<CR>
map <leader>C <Action>(CloseOtherTabs)

map <C-j> <C-w>j
map <C-k> <C-w>k
map <C-h> <C-w>h
map <C-l> <C-w>l

map <C-w>q <C-w><C-q>

map <leader>j "0P

set relativenumber
set number
set ignorecase
set which-key

"" Map \b to toggle the breakpoint on the current line
"map \b <Action>(ToggleLineBreakpoint)
